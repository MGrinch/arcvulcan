{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "retrieval_eval_report@1",
  "type": "object",
  "required": ["schema_version", "run_id", "issue_id", "tests_total", "tests_passed", "cases"],
  "properties": {
    "schema_version": {"const": "retrieval_eval_report@1"},
    "run_id": {"type": "string"},
    "issue_id": {"type": "string"},
    "seed": {"type": "integer"},
    "bench_path": {"type": "string"},
    "grounding_dir": {"type": "string"},
    "k": {"type": "integer"},
    "mode": {"type": "string"},
    "tests_total": {"type": "integer"},
    "tests_passed": {"type": "integer"},
    "recall_at_k": {"type": "number"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["query", "expect", "got", "pass"],
        "properties": {
          "query": {"type": "string"},
          "expect": {"type": "array", "items": {"type": "string"}},
          "got": {"type": "array", "items": {"type": "string"}},
          "pass": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}