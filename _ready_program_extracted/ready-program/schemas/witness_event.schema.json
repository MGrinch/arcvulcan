{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/witness_event.schema.json",
  "title": "WitnessEvent",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "issue_id",
    "created_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[0-9a-f]{12}$"
    },
    "issue_id": {
      "type": "string",
      "pattern": "^ISSUE-[0-9]{8}-[0-9]{3}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "Z$"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}