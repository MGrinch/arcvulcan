{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mutation_report@1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "issue_id",
    "engine",
    "target",
    "overall"
  ],
  "properties": {
    "schema_version": {
      "const": "mutation_report@1"
    },
    "run_id": {
      "type": "string"
    },
    "issue_id": {
      "type": "string"
    },
    "engine": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "overall": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE"
      ]
    },
    "command": {
      "type": "array"
    },
    "problems": {
      "type": "array"
    },
    "details": {
      "type": "array"
    }
  },
  "additionalProperties": true
}