{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MGrinch/arcvulcan/experiments/agentic_trace_roi/trace_fixture.schema.json",
  "title": "ArcVulcan Agentic Trace Fixture",
  "type": "object",
  "required": [
    "trace_id",
    "source",
    "task_family",
    "messages",
    "tool_calls",
    "commands",
    "observations",
    "outcome",
    "reward",
    "tags"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": ["agenttrove", "local", "manual"]
    },
    "task_family": {
      "type": "string",
      "enum": ["code_repair", "terminal", "repo_triage", "math", "computer_use", "unknown"]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command"],
        "properties": {
          "command": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "exit_code": {
            "type": ["integer", "null"]
          },
          "hypothesis": {
            "type": "string"
          },
          "expected_observation": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "outcome": {
      "type": "string",
      "enum": ["success", "failure", "unknown"]
    },
    "reward": {
      "type": ["number", "integer", "null"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}

