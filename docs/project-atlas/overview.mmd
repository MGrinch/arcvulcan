%% A welding tutor that follows your reasoning
%% Working code: Tutor prototype on master; default replies are simulated. Live teaching and learning benefit were not tested.
flowchart TB
n_memory@{ shape: cyl, label: "Your current skill map<br/>Saved topic progress helps<br/>choose the next focus." }
n_choose@{ shape: rounded, label: "Choose a welding topic<br/>Focus on a topic that needs<br/>attention." }
n_teach@{ shape: rounded, label: "Explain and ask<br/>Give a teaching passage and<br/>one question." }
n_predict@{ shape: rounded, label: "Predict a possible answer<br/>Optional helper estimates<br/>what the learner might say." }
n_you@{ icon: "lucide:user-round", form: "circle", label: "Your actual answer<br/>Your reply stays separate<br/>from the prediction.", pos: "b", h: 40 }
n_check@{ shape: diam, label: "Probe further or move<br/>on?" }
n_probe@{ shape: rounded, label: "Ask a focused follow-up<br/>Address the same topic with a<br/>shorter prompt." }
n_record@{ shape: doc, label: "A record of the lesson<br/>Keep teaching, answers and<br/>why the tutor continued." }
n_memory -->|"Topic progress"| n_choose
n_choose -->|"The topic to teach"| n_teach
n_teach -->|"Teaching and a question"| n_you
n_teach -->|"The same question"| n_predict
n_predict -->|"Optional predicted answer"| n_check
n_you -->|"The real answer"| n_check
n_check -->|"More reasoning needed"| n_probe
n_probe -->|"A focused next question"| n_you
n_check -->|"Updated topic progress"| n_memory
n_check -->|"Teaching and decision history"| n_record
classDef person fill:#E8EDF5,stroke:#334766,color:#1D2F48,stroke-width:2px;
classDef source fill:#F2F4F7,stroke:#66778A,color:#283D50,stroke-width:2px;
classDef action fill:#EAF3FF,stroke:#2866AC,color:#172E49,stroke-width:2px;
classDef decision fill:#FFF2D8,stroke:#986200,color:#5B3B06,stroke-width:2px;
classDef memory fill:#F2ECFF,stroke:#7951AE,color:#422760,stroke-width:2px;
classDef result fill:#E7F6EC,stroke:#247A4C,color:#14482F,stroke-width:2px;
class n_memory memory;
class n_choose action;
class n_teach action;
class n_predict action;
class n_you person;
class n_check decision;
class n_probe action;
class n_record result;
